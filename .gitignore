# .gitignore for Enterprise RAG System

# Environment & secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data directories (raw docs and index files — never commit)
data/raw/*
!data/raw/.gitkeep
data/faiss_index/*
!data/faiss_index/.gitkeep

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
